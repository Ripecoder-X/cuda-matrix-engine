{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CME_CUDA_ARCHITECTURES": "89",
        "CME_BUILD_TESTS": "ON",
        "CME_BUILD_BENCHMARKS": "ON",
        "CME_BUILD_EXAMPLES": "ON",
        "CME_WITH_CUBLAS": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CME_CUDA_ARCHITECTURES": "89",
        "CME_BUILD_TESTS": "ON",
        "CME_BUILD_BENCHMARKS": "ON",
        "CME_BUILD_EXAMPLES": "ON",
        "CME_WITH_CUBLAS": "OFF"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CME_CUDA_ARCHITECTURES": "89",
        "CME_BUILD_TESTS": "ON",
        "CME_BUILD_BENCHMARKS": "ON",
        "CME_BUILD_EXAMPLES": "ON",
        "CME_WITH_CUBLAS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
